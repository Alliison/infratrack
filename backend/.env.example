# Modelo do .env. Copie para .env e ajuste.
#
# ⚠️ Comentario SEMPRE em linha propria, nunca depois do valor: o env_file do
# docker compose nao promete remover `# ...` do fim da linha, e um TTL viraria
# a string "300   # validade", que o pydantic rejeita no boot.

# URL publica onde o backend e' acessivel PELO CELULAR que vai escanear o
# QR-code. Precisa ser alcancavel pelo telefone (mesma rede local ou dominio
# publico). Se ficar localhost, o QR nao funciona no celular.
# Producao (VM 100): https://infra.it.vistotrack.com:8443
# Dev local:         http://192.168.0.50:8000
TRACKINFRA_PUBLIC_BASE_URL=http://localhost:8000

# Empresa/indice no FullTrack (8813 = Impacto Telecomunicacoes)
TRACKINFRA_FULLTRACK_INDICE=8813
TRACKINFRA_FULLTRACK_EMP_SLUG=8813-impacto-telecomunicacoes

# Validade do QR-code, em segundos (5 min)
TRACKINFRA_QR_SESSION_TTL=300

# Validade da sessao na TV, em segundos. 0 = nunca expira (a TV nao volta pro QR)
TRACKINFRA_APP_TOKEN_TTL=0

# Onde o mosaico salvo e' persistido. No container e' um caminho absoluto no
# volume (/data/mosaic_config.json), porque o rootfs sobe read-only.
TRACKINFRA_CONFIG_PATH=mosaic_config.json
