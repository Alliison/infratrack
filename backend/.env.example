# URL pública onde o backend é acessível PELO CELULAR que vai escanear o QR-code.
# Precisa ser alcançável pelo telefone (mesma rede local ou IP/domínio público).
# Ex.: http://192.168.0.50:8000  ou  https://trackinfra.impacto.local
TRACKINFRA_PUBLIC_BASE_URL=http://localhost:8000

# Empresa/índice no FullTrack (8813 = Impacto Telecomunicações)
TRACKINFRA_FULLTRACK_INDICE=8813
TRACKINFRA_FULLTRACK_EMP_SLUG=8813-impacto-telecomunicacoes

# Tempos de vida (segundos)
TRACKINFRA_QR_SESSION_TTL=300          # validade do QR-code (5 min)
TRACKINFRA_APP_TOKEN_TTL=604800        # validade da sessão na TV (7 dias)

# Arquivo onde o mosaico salvo é persistido
TRACKINFRA_CONFIG_PATH=mosaic_config.json
